# amoCRM integration for the lead form (app/api/lead/route.ts)
#
# 1. In amoCRM: Settings -> Integrations -> create a private integration,
#    then generate a long-lived access token for it
#    (Настройки -> Интеграции -> ваша интеграция -> "Долгосрочный токен").
# 2. AMOCRM_SUBDOMAIN is the part before ".amocrm.ru" in your account URL,
#    e.g. for https://mycompany.amocrm.ru it's "mycompany".
# 3. AMOCRM_PIPELINE_ID / AMOCRM_STATUS_ID are optional — if set, new leads
#    are created directly in that pipeline/stage. Leave unset to use the
#    account's default pipeline.
#
# Until these are set, the /api/lead route logs submissions to the server
# console instead of failing, so no leads are lost during development.

AMOCRM_SUBDOMAIN=
AMOCRM_ACCESS_TOKEN=
AMOCRM_PIPELINE_ID=
AMOCRM_STATUS_ID=
